# ===== DATABASE (MySQL) =====
# Lokal: MySQL/XAMPP/Laragon. Produksi: TiDB Cloud / Aiven / Railway / PlanetScale-compatible MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alyas_green_space
# Isi "true" jika provider cloud mewajibkan SSL (TiDB Cloud, Aiven, dsb.)
DB_SSL=false

# ===== AUTH =====
# Minimal 32 karakter acak. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Izinkan pendaftaran akun baru dari halaman login (default false: hanya akun hasil seed)
ALLOW_REGISTER=false

# ===== AKUN AWAL (dipakai oleh `npm run db:seed`) =====
SEED_EMAIL=alya@greenspace.local
SEED_PASSWORD=GantiPasswordIni123!
# Isi "true" untuk sekalian membuat data demo (khusus development)
SEED_DEMO_DATA=true

# ===== ZONA WAKTU =====
# Dipakai untuk menentukan "hari ini", greeting pagi/siang/malam, dan streak
APP_TIMEZONE=Asia/Jakarta
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta

# ===== UPLOAD FOTO =====
# Di Vercel, filesystem tidak permanen -> aktifkan Vercel Blob (Storage > Blob) dan token ini terisi otomatis.
# Kalau kosong, foto disimpan di folder ./uploads (cocok untuk lokal).
BLOB_READ_WRITE_TOKEN=

# ===== MUSIK LATAR =====
# Taruh file lagu di public/music/lagu.mp3, atau ganti path/URL di sini.
NEXT_PUBLIC_MUSIC_SRC=/music/lagu.mp3
NEXT_PUBLIC_MUSIC_TITLE=Lagu untuk Alya
NEXT_PUBLIC_DEFAULT_PHOTO=/images/alya.jpg
